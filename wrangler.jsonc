{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snapper",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // No deployment's values live here. Each Worker gets its own with `npx wrangler secret put <NAME>`:
  //   SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY, GEMINI_API, GROQ_API
  // Variables set in the Cloudflare dashboard are kept across deploys.
  "keep_vars": true
}
