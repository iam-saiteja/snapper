{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snapper",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Public values only. Secrets (GEMINI_API, GROQ_API, SUPABASE_SECRET_KEY) are set with `wrangler secret put`.
  "vars": {
    "SUPABASE_URL": "https://dpolzjyyjnkcncroxkmc.supabase.co"
  }
}
